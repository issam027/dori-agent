{
  "name": "dorify-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Outbound-only control-plane agent for autonomous Dorify installations",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run audit:architecture && npm run format:check && npm run typecheck && npm test && npm run build",
    "audit:architecture": "node tools/architecture-check.cjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.8.1"
  }
}
