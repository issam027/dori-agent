NODE_ENV=development
AGENT_ENABLED=false
AGENT_PORT=3100
AGENT_POLL_INTERVAL_MS=30000
AGENT_REQUEST_TIMEOUT_MS=10000

# Local Dorify installation. The agent never exposes this URL to the cloud.
DORIFY_ENGINE_URL=http://engine:3000
DATABASE_URL=postgresql://dori:dori_password@postgres:5432/dori

# Provisioned by the future cloud enrollment workflow.
DORIFY_CLOUD_URL=https://api.dorify.fr
DORIFY_INSTALLATION_ID=00000000-0000-4000-8000-000000000000
DORIFY_CLOUD_TOKEN=replace-with-installation-specific-token

# Optional mutual-TLS files. Mount them read-only; never commit them.
# DORIFY_MTLS_CERT_PATH=/run/secrets/dorify-agent.crt
# DORIFY_MTLS_KEY_PATH=/run/secrets/dorify-agent.key
# DORIFY_MTLS_CA_PATH=/run/secrets/dorify-cloud-ca.crt

DORIFY_ENGINE_VERSION=dev
DORIFY_APP_VERSION=dev
DORIFY_AGENT_VERSION=0.1.0

# Same database budget as the API; listeners are outside query pools.
DB_MAX_CONNECTIONS=100
DB_RESERVED_CONNECTIONS=20
DB_API_INSTANCES=1
DB_POOL_MAX=10
DB_AGENT_INSTANCES=1
DB_AGENT_POOL_MAX=3
DB_WORKER_CONNECTIONS=0
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
REALTIME_SAFETY_REFRESH_MS=300000
# DATABASE_LISTEN_URL=postgresql://user:password@direct-host/database

# Maximum sync work performed in one poll (defaults from config.ts).
AGENT_SYNC_MAX_BATCHES=100
AGENT_SYNC_BUDGET_MS=10000
